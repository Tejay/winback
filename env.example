# Phase 1 — set these first
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_KEY=
CRON_SECRET=

# Phase 3 — add when setting up Stripe
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_WEBHOOK_SECRET=

# Optional — operator-managed Price IDs per tier. If unset, the tier
# resolver looks the Price up by lookup_key (winback_starter_monthly_v2
# etc.) and auto-creates one if missing. Set these in production so the
# Prices are visible/editable in the Stripe dashboard.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# Slack incoming-webhook URL (or any URL that accepts JSON) for internal
# alerts: enterprise tier detection, FX refresh failures, MRR
# reconciliation divergence. Optional — if unset, alerts log to console only.
INTERNAL_ALERT_CHANNEL=

# Phase 4 — add when setting up Anthropic + Gmail
ANTHROPIC_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

NEXT_PUBLIC_APP_URL=http://localhost:3000
